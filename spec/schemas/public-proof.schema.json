{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neosmartui.com/schemas/public-proof@1.json",
  "title": "NeoSmartUI Public Proof Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "component", "deployedSource", "implementationFiles", "browserEvidence", "deployment", "live"],
  "properties": {
    "$schema": {"type": "string"},
    "schema": {"const": "neosmartui/public-proof@1"},
    "component": {"type": "string", "pattern": "^(?!flavor\\.|vertical\\.)[a-z][a-z0-9-]*\\.(?!block\\.|page\\.)[a-z][a-z0-9-]*$"},
    "deployedSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "sha"],
      "properties": {
        "repository": {"const": "neosmartui/neosmartui"},
        "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "implementationFiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "blobSha"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "blobSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
        }
      }
    },
    "browserEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "artifactId"],
      "properties": {
        "runId": {"type": "integer", "minimum": 1},
        "artifactId": {"type": "integer", "minimum": 1}
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commitSha", "treeSha", "pagesRunId"],
      "properties": {
        "repository": {"const": "neosmartui/neosmartui.github.io"},
        "commitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "treeSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "pagesRunId": {"type": "integer", "minimum": 1}
      }
    },
    "live": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pageUrl", "deploymentRecordUrl"],
      "properties": {
        "pageUrl": {"type": "string", "pattern": "^https://neosmartui\\.github\\.io/$"},
        "deploymentRecordUrl": {"type": "string", "pattern": "^https://neosmartui\\.github\\.io/deployment\\.json$"}
      }
    }
  }
}
